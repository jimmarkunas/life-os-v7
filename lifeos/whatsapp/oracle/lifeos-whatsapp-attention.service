# COMM-1.3 (LIFE-30): Jim's personal WhatsApp attention as one dedicated linked device. Counts and the latest sender in memory; answers only on a
# 0600 Unix socket. No output (stdout/stderr discarded), memory-capped, restarts after a crash, never re-pairs by itself.
[Unit]
Description=LIFE OS WhatsApp attention (dedicated linked device; counts only)
After=network-online.target

[Service]
WorkingDirectory=%h/.local/lib/lifeos-whatsapp
ExecStart=%h/.openclaw/tools/node/bin/node %h/.local/lib/lifeos-whatsapp/attention.mjs serve
Restart=on-failure
RestartSec=30
UMask=0077
MemoryMax=400M
NoNewPrivileges=yes
# LIFE-643 row 4: sandbox lines that need no mount namespace. ProtectSystem, PrivateTmp, ProtectKernel* and ProtectControlGroups are NOT set:
# on Oracle (Ubuntu 24.04, kernel.apparmor_restrict_unprivileged_userns=1) an unprivileged user manager cannot write a uid_map, so those would fail with 226/NAMESPACE.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
