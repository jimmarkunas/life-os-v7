# LIFE-889: Honcho v3.6.1 settings. NO secrets here: the Anthropic key lives only in the metering proxy; Honcho holds a dummy value.
# Every text feature uses claude-haiku-5-5 through the metering proxy; embeddings use nomic-embed-text (768 dimensions) on the local Ollama, also through the proxy.
LLM_ANTHROPIC_API_KEY=dummy-local-not-a-key
LLM_OPENAI_API_KEY=dummy-local-not-a-key
AUTH_USE_AUTH=false
EMBED_MESSAGES=true
EMBEDDING_VECTOR_DIMENSIONS=768
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://172.28.0.1:8081/v1
DERIVER_MODEL_CONFIG__TRANSPORT=anthropic
DERIVER_MODEL_CONFIG__MODEL=claude-haiku-5-5
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://172.28.0.1:8081
SUMMARY_MODEL_CONFIG__TRANSPORT=anthropic
SUMMARY_MODEL_CONFIG__MODEL=claude-haiku-5-5
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=http://172.28.0.1:8081
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=anthropic
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=claude-haiku-5-5
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://172.28.0.1:8081
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=anthropic
DREAM_INDUCTION_MODEL_CONFIG__MODEL=claude-haiku-5-5
