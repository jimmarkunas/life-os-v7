# LIFE-977: the Concord health helper's local listener. A Unix socket only (no TCP, nothing on a tailnet or public address): the private endpoint, which runs as ubuntu,
# is the one client. The socket belongs to concord and is group ubuntu, mode 0660; no process runs between connections. No timer, no scheduler.
[Unit]
Description=LIFE OS Concord health helper (local socket for the private endpoint only)

[Socket]
ListenStream=/run/lifeos-concord/concord.sock
SocketUser=concord
SocketGroup=ubuntu
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=2
MaxConnectionsPerSource=2

[Install]
WantedBy=sockets.target
