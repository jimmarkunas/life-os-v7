#!/bin/sh
# LIFE-875 / LIFE-888: place named Bitwarden secrets into the governed MCP service's own encrypted credentials. Deployed as /opt/lifeos-buzz-mcp/current/bin/place-credentials; run with sudo.
#   sudo /opt/lifeos-buzz-mcp/current/bin/place-credentials <bitwarden secret name>...
# For each allowed name it runs `bws` as the account that already owns the vault token (ubuntu, with that user's env file; the token is never loaded by the caller), finds the secret by name, and hands the value to
# `systemd-creds encrypt` for the service through a pipe in memory. Prints ONLY "<name> ok" or "<name> missing". A value is never echoed, logged or written anywhere except the encrypted credential file; the file is
# written 0600 beside the service's other credentials; an unknown name, a name Bitwarden does not return, or an empty value is "missing" and changes nothing. After placing, it writes one systemd drop-in that loads every
# credential file present (LoadCredentialEncrypted) and reloads systemd; restarting the service is a separate, recorded step.
set -u
umask 077
DIR="${PLACE_CREDENTIALS_DIR:-/etc/lifeos-buzz-mcp}"
ENVFILE="${PLACE_CREDENTIALS_ENV:-/home/ubuntu/.config/bws/openclaw.env}"
RUNAS="${PLACE_CREDENTIALS_USER:-ubuntu}"
DROPIN="${PLACE_CREDENTIALS_DROPIN:-/etc/systemd/system/lifeos-buzz-mcp.service.d/credentials-google-notion.conf}"
CREDS="google_read_client_id google_read_client_secret google_read_personal_gmail_refresh google_read_bytalos_gmail_refresh google_read_personal_drive_refresh google_read_bytalos_drive_refresh notion_readonly_token buzz_key_claude_pilot buzz_key_muse_life_os buzz_key_duet_life_os buzz_key_duet_bytalos buzz_key_duet_pilot"

credential_for() {                                    # the closed list: Bitwarden secret name -> the service's credential name (its environment name, lower case)
  case "$1" in
    openclaw/gmail/clientId) echo google_read_client_id ;;
    openclaw/gmail/clientSecret) echo google_read_client_secret ;;
    GMAIL_OAUTH_REFRESH_TOKEN|lifeos/edge/GMAIL_OAUTH_REFRESH_TOKEN) echo google_read_personal_gmail_refresh ;;
    FOLLOWUP_GMAIL_BYTALOS_READONLY_REFRESH|lifeos/edge/FOLLOWUP_GMAIL_BYTALOS_READONLY_REFRESH) echo google_read_bytalos_gmail_refresh ;;
    openclaw/drive/refreshToken) echo google_read_personal_drive_refresh ;;
    openclaw/drive-bytalos/refreshToken) echo google_read_bytalos_drive_refresh ;;
    NOTION_READONLY_TOKEN|lifeos/edge/NOTION_READONLY_TOKEN) echo notion_readonly_token ;;
    lifeos/edge/BUZZ_KEY_MUSE_LIFE_OS) echo buzz_key_muse_life_os ;;      # LIFE-923: Muse's own member key for the life-os community (read as BUZZ_KEY_MUSE_LIFE_OS)
    lifeos/edge/BUZZ_KEY_DUET_LIFE_OS) echo buzz_key_duet_life_os ;;      # LIFE-922: Duet's own member keys, one per community (read as BUZZ_KEY_DUET_<COMMUNITY>)
    lifeos/edge/BUZZ_KEY_DUET_BYTALOS) echo buzz_key_duet_bytalos ;;
    lifeos/edge/BUZZ_SELFHOST_AGENT_DUET) echo buzz_key_duet_pilot ;;      # LIFE-922: Duet's own member key on the private relay pilot; read as BUZZ_KEY_DUET_PILOT only when BUZZ_RELAY=pilot
    lifeos/edge/BUZZ_SELFHOST_AGENT_CLAUDE) echo buzz_key_claude_pilot ;;      # LIFE-870: the Claude connector's own member key on the private relay pilot; read as BUZZ_KEY_CLAUDE_PILOT only when BUZZ_RELAY=pilot
    lifeos/edge/ANTHROPIC_ADMIN_KEY) echo anthropic_admin_key ;;          # LIFE-921: read ONLY by the Anthropic report reader unit (run with PLACE_CREDENTIALS_DIR=/etc/lifeos-anthropic-report and its own PLACE_CREDENTIALS_DROPIN); never loaded by the MCP service
    lifeos/edge/BUZZ_SELFHOST_RELAY_KEY) echo buzz_selfhost_relay_key ;;   # LIFE-870: read by the private relay pilot (lifeos-buzz-selfhost), NOT loaded by the MCP service (it is not in CREDS above)
    *) return 1 ;;
  esac
}

place() {                                             # $1 secret name, $2 credential name: exit 0 placed, 3 missing
  sudo -u "$RUNAS" -H sh -c 'set -a; . "$1"; set +a; exec bws secret list -o json' _ "$ENVFILE" 2>/dev/null | python3 -I -c '
import json, os, subprocess, sys
name, cred, out = sys.argv[1:4]
try:
    secrets = json.load(sys.stdin)
    value = next((s.get("value") for s in secrets if s.get("key") == name), "")
except Exception:
    value = ""
if not isinstance(value, str) or not value.strip():
    sys.exit(3)
tmp = out + ".part"
try:
    done = subprocess.run(["systemd-creds", "encrypt", "--name=" + cred, "-", tmp], input=value.encode(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if done.returncode != 0:
        sys.exit(3)
    os.chmod(tmp, 0o600)
    os.replace(tmp, out)
finally:
    value = ""
    if os.path.exists(tmp):
        os.remove(tmp)
' "$1" "$2" "$DIR/$2.cred"
}

if [ "${1:-}" = "--list-names" ]; then                 # diagnostic: the NAMES of the secrets the vault owner's token can see that match a word (case-insensitive), never a value; changes nothing
  [ -n "${2:-}" ] || { echo "usage: place-credentials --list-names <word>" >&2; exit 64; }
  sudo -u "$RUNAS" -H sh -c 'set -a; . "$1"; set +a; exec bws secret list -o json' _ "$ENVFILE" 2>/dev/null | python3 -I -c '
import json, sys
word = sys.argv[1].lower()
try:
    names = sorted({repr(s.get("key")) for s in json.load(sys.stdin) if word in str(s.get("key", "")).lower()})
except Exception:
    names = ["<unreadable>"]
print("\n".join(names) if names else "<none>")
' "$2"
  exit 0
fi
[ "$#" -gt 0 ] || { echo "usage: place-credentials <bitwarden secret name>..." >&2; exit 64; }
for name in "$@"; do
  cred=$(credential_for "$name") || { echo "$name missing"; continue; }
  if place "$name" "$cred"; then echo "$name ok"; else echo "$name missing"; fi
done

mkdir -p "$(dirname "$DROPIN")"
{
  echo "[Service]"
  for cred in $CREDS; do
    [ -f "$DIR/$cred.cred" ] && echo "LoadCredentialEncrypted=$cred:$DIR/$cred.cred"
  done
} > "$DROPIN"
[ -n "${PLACE_CREDENTIALS_DROPIN:-}" ] || systemctl daemon-reload
exit 0
