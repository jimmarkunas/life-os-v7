#!/usr/bin/env python3
"""LIFE-870: generate Buzz pilot keys ON ORACLE and store them in Bitwarden without any agent seeing them (the counterpart of place-credentials).

  sudo /opt/lifeos-buzz-mcp/current/bin/store-credential check
  sudo /opt/lifeos-buzz-mcp/current/bin/store-credential <name>...        names from the closed list below, as secrets named lifeos/edge/<name>

Runs `bws` as the account that already owns the vault token (ubuntu, with that user's own env file); the token is read here only to hand to bws and is never printed. `check` first proves WRITE access to the project with a
synthetic probe secret that it deletes again. A real key is generated here (32 random bytes, a valid secp256k1 secret), written with `bws secret create`, and never printed or saved anywhere else; a name that already
exists is never overwritten. Prints ONLY `<name> <secret id> ok pubkey=<public key>`, `<name> exists`, `<name> failed` or `check write_ok|no_write|no_project`. A public key is not a secret and is what the relay's membership needs.
ACCEPTED RISK (Jim, Nov 22 2026, LIFE-870 comment 13819, permanent): `bws secret create` takes the value as a command-line argument, so for the few milliseconds bws runs the value is readable in that process's
arguments by any local account (the host has no hidepid). Jim accepted this brief exposure on Oracle as permanent; only pilot keys are generated this way, and the closed list does not include anything else."""
import json
import os
import pwd
import secrets
import subprocess
import sys

PROJECT = os.environ.get("STORE_CREDENTIALS_PROJECT", "LIFE OS EDGE/OPENCLAW")
ENVFILE = os.environ.get("STORE_CREDENTIALS_ENV", "/home/ubuntu/.config/bws/openclaw.env")
RUNAS = os.environ.get("STORE_CREDENTIALS_USER", "ubuntu")
PREFIX = "lifeos/edge/"
NAMES = ("BUZZ_SELFHOST_OWNER_KEY", "BUZZ_SELFHOST_RELAY_KEY", "BUZZ_SELFHOST_AGENT_HERMES_DEVELOPER", "BUZZ_SELFHOST_AGENT_CLAUDE", "BUZZ_SELFHOST_AGENT_CHATGPT")
N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
for up in ("..", "../.."):                                                           # installed as <release>/bin/store-credential, or run from a checkout as deploy/buzz-mcp/store-credential
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), up))


def vault_env():
    """The vault owner's own env file -> the environment bws needs (the token goes to bws only)."""
    env = dict(os.environ)
    for line in open(ENVFILE).read().splitlines():
        line = line.strip().removeprefix("export ")
        if "=" in line and not line.startswith("#"):
            key, _, value = line.partition("=")
            env[key.strip()] = value.strip().strip("'\"")
    return env


def bws(env, *args):
    done = subprocess.run(["bws", *args], capture_output=True, text=True, env=env, check=False)
    return done.returncode, done.stdout


def project_id(env):
    code, out = bws(env, "project", "list", "-o", "json")
    try:
        return next(p["id"] for p in json.loads(out) if p.get("name") == PROJECT) if code == 0 else None
    except (ValueError, StopIteration, KeyError, TypeError):
        return None


def existing(env, project):
    code, out = bws(env, "secret", "list", project, "-o", "json")
    try:
        return {s.get("key") for s in json.loads(out)} if code == 0 else None
    except (ValueError, TypeError):
        return None


def new_key():
    while True:
        value = secrets.token_bytes(32)
        if 0 < int.from_bytes(value, "big") < N:
            return value.hex()


def create(env, project, key, value):
    code, out = bws(env, "secret", "create", key, value, project, "-o", "json")
    try:
        return json.loads(out).get("id") if code == 0 else None
    except (ValueError, AttributeError):
        return None


def check(env, project):
    probe = "LIFEOS_STORE_PROBE_" + secrets.token_hex(6)
    ident = create(env, project, probe, "synthetic-write-probe-" + secrets.token_hex(8))
    if not ident:
        return "no_write"
    return "write_ok" if bws(env, "secret", "delete", ident)[0] == 0 else "probe_left_behind_" + probe


def store(env, project, name, taken):
    if name not in NAMES:
        return f"{name} failed"
    if PREFIX + name in taken:
        return f"{name} exists"
    from lifeos.buzz import nip98
    value = new_key()
    ident = create(env, project, PREFIX + name, value)
    pubkey = nip98.pubkey(bytes.fromhex(value)) if ident else None
    value = ""
    return f"{name} {ident} ok pubkey={pubkey}" if ident else f"{name} failed"


def main(argv):
    os.umask(0o077)
    if not argv:
        print("usage: store-credential check | <name>...", file=sys.stderr)
        return 64
    if os.geteuid() == 0 and pwd.getpwnam(RUNAS).pw_uid != 0:                       # re-run as the vault owner; root never sees the token
        os.execvp("sudo", ["sudo", "-u", RUNAS, "-H", "env", "PYTHONDONTWRITEBYTECODE=1", sys.executable, "-I", os.path.abspath(__file__), *argv])
    try:
        env = vault_env()
    except OSError:
        print("check no_vault")
        return 0
    project = project_id(env)
    if not project:
        print("check no_project")
        return 0
    if argv == ["check"]:
        print("check " + check(env, project))
        return 0
    taken = existing(env, project)
    if taken is None:
        print("check cannot_list")
        return 0
    for name in argv:
        print(store(env, project, name, taken))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
